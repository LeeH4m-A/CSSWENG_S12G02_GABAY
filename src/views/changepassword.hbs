<link rel="stylesheet" href="/css/common.css">
<link rel="stylesheet" href="/css/login.css">
<link rel="stylesheet" href="/css/signup.css">
<link rel="stylesheet" href="/css/forgotpassword.css">


<div class="parent-registration">
        <!-- left section : image -->
        <div class="leftSide">
            <div class="img">
                <img class="logo" src="/logo.png" alt="logo"/>
            </div>
        </div>

    <!-- right section : form -->
    <div class="rightSide_dpa">
    <div class="rightSide">
        <p class="main"><b>Change Password</b></p>
        <p class="details">Enter Your New Password</p>
        
        <form name="change-password" action="change-password" method="post">
            <div class="form-group password-container"> 
                <input name="oldPassword" id="old-password-field" type="password" placeholder="Enter Old Password" minlength="8" required> 
                <span class="toggle-password" onclick="togglePassword('old-password-field')">&#128065;</span>
            </div>
            <div class="form-group password-container">
                <input name="password" id="password-field" type="password" placeholder="Enter New Password" minlength="8" required>
                <span class="toggle-password" onclick="togglePassword('password-field')">&#128065;</span>
            </div>
            <div class="form-group password-container">
                <input name="confirmPassword" id="confirm-password-field" type="password" placeholder="Confirm New Password" minlength="8" required>
                <span class="toggle-password" onclick="togglePassword('confirm-password-field')">&#128065;</span>
            </div>
            
            <input type="submit" class="registration" value="Change Password">
        </form>
    </div>
    </div>
</div>





<script>
function togglePassword(fieldId) {
    const input = document.getElementById(fieldId);
    if (input.type === "password") {
        input.type = "text";
    } else {
        input.type = "password";
    }
}
</script>

<style>
.parent-registration {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    background-color: white;
    min-height: 100vh;
    width: 100%;
    box-sizing: border-box;
    overflow-y: auto;
}

.leftSide{
    margin-top: min(10%, 100px);
}

.rightSide {
    margin-top: 30%;
    background-color: #9B112E;
    border-radius: 20px;
    box-shadow: 0px 0px 20px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    box-sizing: border-box;
    width: 100%;
    max-height: 90%;
}


.toggle-password {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    cursor: pointer;
    color: white;
    font-size: 18px;
    user-select: none;
    transition: color 0.3s ease;
    z-index: 2;
}

.password-container{
    width: 100%;
}

.rightSide_dpa {
    display: flex;
    flex-direction: column;
    flex-wrap: nowrap;
    width:  max(30%, 600px);
    max-width: 600px;
    gap: 15px;
}


.rightSide_dpa > p {
    padding: 10px 15px;
    margin: 15px 0;
    border-radius: 4px;
    background-color: #f0f7fb;
    color: #333;
    font-size: 0.90em;
}


@media (max-width: 1280px) {

    .rightSide_dpa{
        width: 70%;
        
    }
    .rightSide{
        margin-top: 10%;
    }
    .logo{
        display: none;
    }
    .form-group {
        flex-direction: column;
    }

    .floating-input {
        width: 100% !important;
        margin-right: 0;
        margin-bottom: 15px;
    }
    
    .floating-input:last-child {
        margin-bottom: 0;
    }
}
</style>
