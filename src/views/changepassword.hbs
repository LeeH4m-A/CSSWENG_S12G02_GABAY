<link rel="stylesheet" href="/css/common.css">
<link rel="stylesheet" href="/css/login.css">
<link rel="stylesheet" href="/css/signup.css">
<link rel="stylesheet" href="/css/forgotpassword.css">
<div class="parent-registration">
        <!-- left section : image -->
        <div class="leftSide">
            <div class="img">
                <img class="logo" src="/logo.png" alt="logo"/>
            </div>
        </div>

    <!-- right section : form -->
    <div class="rightSide">
        <p class="main"><b>Change Password</b></p>
        <p class="details">Enter Your New Password</p>
        
        <form name="change-password" action="change-password" method="post">
            <div class="form-group password-container"> 
                <input name="oldPassword" id="old-password-field" type="password" placeholder="Enter Old Password" minlength="8" required> 
                <span class="toggle-password" onclick="togglePassword('old-password-field')">&#128065;</span>
            </div>
            <div class="form-group password-container">
                <input name="password" id="password-field" type="password" placeholder="Enter New Password" minlength="8" required>
                <span class="toggle-password" onclick="togglePassword('password-field')">&#128065;</span>
            </div>
            <div class="form-group password-container">
                <input name="confirmPassword" id="confirm-password-field" type="password" placeholder="Confirm New Password" minlength="8" required>
                <span class="toggle-password" onclick="togglePassword('confirm-password-field')">&#128065;</span>
            </div>
            
            <input type="submit" class="registration" value="Change Password">
        </form>
    </div>
</div>





<script>
function togglePassword(fieldId) {
    const input = document.getElementById(fieldId);
    if (input.type === "password") {
        input.type = "text";
    } else {
        input.type = "password";
    }
}
</script>

<style>
.password-container {
    position: relative;
}
.toggle-password {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    cursor: pointer;
    font-size: 1.2rem;
    user-select: none;
}
</style>
