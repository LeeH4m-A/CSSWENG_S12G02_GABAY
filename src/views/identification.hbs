{{! Temporary ID}}
{{> sidebar}}
<div class="main-content">
    <div class="container-for-profile">
        <div class="profile-fields">
            <div class="id-info">
                <div class="photo" style="margin-bottom: 15px;">
                    <img id="idPhoto" src="https://res.cloudinary.com/dof7fh2cj/image/upload/v1719207075/hagwnwmxbpkpczzyh46g.jpg" alt="ID Photo"
                    style="width: 50%; height: 50%; border-radius: 10px; object-fit: cover; border: 2px solid #ccc;">
                </div>
                <div>
                    <p><b id="profile-label">{{user.name}}</b></p>
                    <p id="idRole" style="color: #d41919;">{{user.role}}</p>
                    <p>ID: <span id="idNumber">{{user._id}}</span></p>
                </div>
            </div>
            <div style="margin-top: 20px; text-align: center;">
                <label for="uploadPhoto" class="registration" style="cursor:pointer;">
                    Upload Photo
                </label>
                <input type="file" id="uploadPhoto" accept="image/*" style="display:none;">
            </div>
        </div>
    </div>
</div>
<style>
.id-info {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    gap: 10px;
}

</style>
<script>
  const upload = document.getElementById('uploadPhoto');
  const photo = document.getElementById('idPhoto');

  upload.addEventListener('change', (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (event) => {
      photo.src = event.target.result;
    };
    reader.readAsDataURL(file);
  });
</script>