{{! Temporary ID}}
{{> sidebar}}

<link rel="stylesheet" href="/css/identification.css">
<link rel="stylesheet" href="/css/data.css">
<link rel="stylesheet" href="/css/profile.css">

<div class="main-content">
  <h1 class="page-title">Identification Card</h1>

  <div class="container-for-profile">
    <div class="organization-banner-wrapper">
      {{> organization_banner}}
    </div>

    <div class="profile-fields">
      <div class="id-info">
        {{! LEFT-SIDE - Profile Photo }}
        <div class="photo-for-profile">
          {{#if user.userIcon}}
            <img id="idPhoto" src="{{user.userIcon}}" alt="Profile Photo"/>
          {{else}}
            <img id="idPhoto" src="https://res.cloudinary.com/dof7fh2cj/image/upload/v1719207075/hagwnwmxbpkpczzyh46g.jpg" alt="No Photo"/>
          {{/if}}

          <div class="photo-overlay">
            <label for="uploadPhoto" class="upload-label">Upload</label>
            <button id="undoPhoto" class="undo-label">Undo</button>
            <button id="revertPhoto" class="revert-label">Default</button>
          </div>
        </div>

        <input type="file" id="uploadPhoto" accept="image/*" style="display:none;">

        {{! RIGHT-SIDE - User Info }}
        <div class="user-info-container">
          <div class="user-header">
            <b id="profile-label" class="editable user-name" data-field="name">
              {{user.name}}
            </b> 
            <span class="user-pronouns">{{user.pronouns}}</span>
          </div>

          <p id="idRole" class="user-role">{{user.role}}</p>
          <p class="user-id">ID: <span id="idNumber">{{user._id}}</span></p>

          <div class="info-grid">
            <div class="info-item">
              <p class="info-label">Join Date</p>
              <p class="info-value">{{user.joinDate}}</p>
            </div>
           
            <div class="info-item">
              <p class="info-label">Sex</p>
              <p class="editable info-value" data-field="gender">{{user.gender}}</p>
            </div>

            <div class="info-item">
              <p class="info-label">Contact No.</p>
              <p class="editable info-value" data-field="contactNo">{{user.contactNo}}</p>
            </div>
            
            <div class="info-item">
              <p class="info-label">Birthday</p>
              <p class="editable info-value" data-field="birthday">{{user.birthday}}</p>
            </div>

            <div class="info-item">
              <p class="info-label">Email</p>
              <p class="info-value">{{user.email}}</p>
            </div>
          </div>
        </div>
      </div>
    
      <div class="location-info">
        <div class="location-item">
          <p class="info-label">Barangay</p>
          <p class="editable info-value" data-field="barangay">
            {{#if user.location.barangay}}
              {{user.location.barangay}}
            {{else}}
              <br>
            {{/if}}
          </p>
        </div>
        <div class="location-item">
          <p class="info-label">City</p>
          <p class="editable info-value" data-field="city">{{user.location.city}}</p>
        </div>
      </div>
    </div>
  </div>

  <div class="action-buttons">
    <button id="editInfoBtn" class="profile-submit-button edit-btn">Edit Info</button>
    <button id="cancelEditBtn" class="profile-submit-button cancel-btn" style="display:none;">Cancel</button>
    <a id="changePassword" class="profile-submit-button cancel-btn" href="/change-password">Change Password</a>
    <button id="printBtn" class="profile-submit-button print-btn">Print</button>
  </div>

  {{> footer}}
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="/profile-id.js"></script>
