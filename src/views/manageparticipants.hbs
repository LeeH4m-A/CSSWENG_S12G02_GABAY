{{> sidebar}}
<div class="main-content">
    
    {{#if modeIsAssign}}
        <div class="header">
            <h1>Assign Participants to {{event.title}}</h1>
        </div>
        <div class="container-for-assign-participants">
            <h2 class="assign-participant-title">Select Participants to Assign</h2>
            
            <form action="/manageparticipants/assign/{{event.id}}" method="POST">
                <div class="user-list">
                    {{#if users}}
                        {{#each users}}
                            <div class="user-item">
                                <input type="checkbox" name="userIds" value="{{this.id}}">
                                <label>{{this.name}} ({{this.role}})</label>
                            </div>
                        {{/each}}
                    {{else}}
                        <p>No new users available to assign.</p>
                    {{/if}}
                </div>
                <div class="form-actions">
                    <button type="submit" class="edit-button">Assign Selected</button>
                    <a href="/viewevents/{{event.id}}" class="cancel-button">Cancel</a>
                </div>
            </form>
        </div>

    {{else}}
        <div class="header">
            <h1>Remove Participants from {{event.title}}</h1>
        </div>
        <div class="container-for-assign-participants">
            <h2 class="assign-participant-title">Select Participants to Remove</h2>
            
            <form action="/manageparticipants/remove/{{event.id}}" method="POST">
                <div class="user-list">
                    {{#if users}}
                        {{#each users}}
                            <div class="user-item">
                                <input type="checkbox" name="userIds" value="{{this.id}}">
                                <label>{{this.name}} ({{this.role}})</label>
                            </div>
                        {{/each}}
                    {{else}}
                        <p>No participants are currently assigned to this event.</p>
                    {{/if}}
                </div>
                <div class="form-actions">
                    <button type="submit" class="edit-button">Remove Selected</button>
                    <a href="/viewevents/{{event.id}}" class="cancel-button">Cancel</a>
                </div>
            </form>
        </div>
    {{/if}}

    {{>footer}}
</div>