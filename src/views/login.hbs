<div class="parent-registration">
    <!-- left section : image -->
    <div class="leftSide">
        <div class="img">
            <img class="logo" src="./logo.png" alt="logo"/>
        </div>
    </div>
    
    <!-- right section : form -->
    <div class="rightSide_dpa">

    <div class="rightSide">
        <p class="main"><b>Welcome Back!</b></p>
        <p class="details">Log in to continue.</p>
    

        <form name="read-user" action="login" method="post">
            <div class="form-group">
                <input name="email" id="email-field" type="email" placeholder="Email" required></input>
            </div>

            <!-- you know this could be a partial, yea-->
            <div class="form-group">
                <div class="full-width password-container">
                    <input name="password" id="password-field" type="password" placeholder="Password" minlength="8" required>
                    <span class="material-symbols-outlined toggle-password" onclick="togglePassword('password-field', this)">
                        visibility_off
                    </span>
                </div>
            </div>
            <div class="form-group">
                <div class="miniform-group">
                    <input type="checkbox" id="remember-me" name="remember" value="true">
                    <label class="remember-me">Remember for 30 days</label>
                </div>
                <div class="miniform-group">
                    <p class="forgot-page"><a class="register" href="/forgot_password">Forgot Password?</a></p>
                </div>
            </div>
            <input type="submit" class="registration" value="Login"></input>
        </form>

        <p class="signup-page">New here? <a class="register" href="/signup">Create an account</a></p>
    </div>

    <p>
    The personal information you provide will be collected, used, and stored in accordance with the Philippine Data Privacy Act of 2012 (RA 10173).
    </p>

    </div>
</div>


<script>
function togglePassword(fieldId, element) {
    const input = document.getElementById(fieldId);
    if (input.type === "password") {
        input.type = "text";
        element.textContent = "visibility";
    } else {
        input.type = "password";
        element.textContent = "visibility_off";
    }
}
</script>