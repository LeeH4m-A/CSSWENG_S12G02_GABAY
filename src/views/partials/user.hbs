<div class="user">
    <div class="user-img">
        {{#if user.userIcon}}
            <img  src="{{user.userIcon}}" alt="Profile Photo"/>
        {{else}}
            <img src="https://cdn.discordapp.com/attachments/1132678773007974530/1435025694139875510/393641643_177514438736266_8754525180358881846_n.png?ex=690a7752&is=690925d2&hm=c1776f928286b3f255fa0e754bf9b0ebe3dcf8ad82fb5dbedd6faa57d9d44de0" alt="No Photo"/>
        {{/if}}
    </div>
    <div class="div">
        <p class="bold">{{user.name}}</p>
        <p>{{user.role}}</p>
    </div>
</div>